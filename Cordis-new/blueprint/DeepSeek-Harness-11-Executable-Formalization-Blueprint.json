    "revision_note": "Formalization pipeline inputs narrowed: Project Guide and Research Ledger are excluded.",
    "purpose": "Turn accepted ADR contracts into a standalone Lean metatheory kernel and a finite executable vertical slice.",
    "scope": "Relation, reversible effects, partial operations, ranked iterators, abstract state/registry, alpha transport, and a two-counter example.",
    "non_goals": [
      "End-to-end verification of the TypeScript Cordis runtime",
      "A complete Section 4 lifecycle/control proof in the first pass",
      "Reopening ADR-01 through ADR-06 or mutating H03/H04 baselines"
    ]
  },
  "decision_profile": {
    "G1": "A: paper metatheory kernel first",
    "G2": "A start: standalone package, with a reserved DeepSeekHarness.CordisAdapter seam",
    "G3": "C: two disjoint counters, failure, ranked iterator, and alpha transport",
    "G4": "C: staged hybrid; shallow executable effects now, deep DSL/interpreter seam reserved",
    "G5": "C: RegistryLike abstraction, Toy List+Nodup registry, later Finmap adapter",
    "G6": "B: general failure retains error, boundary, and successful-prefix undo; atomicity is Toy-only",
    "state_carrier": "abstract StateLike first, then ADR-03 RawState/ValidState adapter",
    "working_validation_profile": "A+I+K+E, with R0 adapter seam only",
    "fixed_architecture": [
      "raw exact computation plus explicit relation-parametric law architecture",
      "no global Setoid and no quotient execution carrier",
      "positive finite ADR-03 state shell; no State -> State closure in FiberCell",
      "lifetime-safe IncarnationId and explicit alpha action",
      "ranked continuation machine with explicit failure result"
    ]
  },
